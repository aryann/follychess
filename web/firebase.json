{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "target": "app",
      "public": "frontend/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "api",
      "public": "api-site",
      "ignore": ["**/.*"],
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "follytest-api",
            "region": "us-west1"
          }
        }
      ]
    }
  ]
}
